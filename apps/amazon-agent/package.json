{
  "name": "@intendr/amazon-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Node service that drives Amazon in a real browser for the AmazonProvider (a Worker can't run Playwright). Mock-first; live behind AMAZON_LIVE=1.",
