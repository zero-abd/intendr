    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@intendr/commerce": "workspace:*"
  },
  "optionalDependencies": {
    "patchright": "^1.58.2"
  },
  "devDependencies": {
    "@intendr/budget": "workspace:*",
    "@intendr/contracts": "workspace:*",
    "@intendr/guardrails": "workspace:*",
    "@intendr/mcp": "workspace:*",
    "@intendr/providers": "workspace:*",
    "@intendr/wallet": "workspace:*",
    "@types/node": "^20.11.0",
    "tsx": "^4.19.2"
  }
}
