# ---------------------------------------------------------------------------
# Lithic virtual-card issuance service
# Copy to `.env` and fill in real values. NEVER commit the populated file.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Demo mode (hackathon / pitch demos)
# When true: skip live Lithic card creation; vault a hardcoded card instead.
# Infrastructure (approval checks, one-card-per-order, consume API) still runs.
# Set to false to use real Lithic SINGLE_USE issuance.
# ---------------------------------------------------------------------------
DEMO_MODE=true
DEMO_CARD_PAN=
DEMO_CARD_CVV=
DEMO_CARD_EXP_MONTH=
DEMO_CARD_EXP_YEAR=

# Lithic API key. Required when DEMO_MODE=false. Optional in demo mode.
# Treat as highly sensitive: never log it, never return it in an API response.
LITHIC_API_KEY=

# "sandbox" (default) or "production".
LITHIC_ENVIRONMENT=sandbox

# Hard ceiling for any single card's spend limit, in the currency's smallest
# unit (cents for USD). Requests above this are rejected before touching Lithic.
MAX_VIRTUAL_CARD_AMOUNT_CENTS=100000

# HTTP port for the Express server.
PORT=8790

# Shared secret required by the internal-only credential-consumption endpoint.
# This authenticates the trusted MCP checkout executor (service-to-service).
INTERNAL_SERVICE_TOKEN=

# How long (seconds) a stored card credential remains redeemable before it
# expires from the in-memory vault.
CREDENTIAL_TTL_SECONDS=900

# Log level for pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Set to "true" to enable the live Lithic sandbox integration test.
RUN_LITHIC_SANDBOX_TESTS=false

# Only used by the sandbox integration test: a Lithic account token that exists
# in your sandbox program to attach the created card to.
LITHIC_SANDBOX_ACCOUNT_TOKEN=
