{
  "name": "@intendr/virtual-cards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lithic single-use virtual-card issuance service for approved MCP transactions.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/virtual-cards/index.ts",
    "./mcp": "./src/virtual-cards/mcpCardTool.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "lithic": "^0.144.0",
    "pino": "^10.3.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
