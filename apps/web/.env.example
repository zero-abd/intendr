# Vite build-time config. Copy to .env.local and fill in. Only VITE_-prefixed
# vars are exposed to the browser. Restart `vite` after changes.

# Supabase — Project Settings → API. Use the ANON / publishable key (safe in the
# browser; Row-Level Security protects the data). NEVER the service_role key.
VITE_SUPABASE_URL=https://YOUR_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: the intendr edge Worker (MCP + API). Not required for the dashboard.
VITE_API_URL=https://api.intendr.app
