---
import Wordmark from "./Wordmark.astro";
const dash = "https://app.intendr.app";
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href="#main" class="nav-brand" aria-label="intendr home">
      <Wordmark size={18} />
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="#demos">What it does</a>
      <a href="#guardrails">Guardrails</a>
      <a href="#connect">Connect</a>
      <a href="#tools">Tools</a>
    </nav>
    <a class="btn btn-primary nav-cta" href={dash}>Open the dashboard</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(12px);
    background: rgba(8, 9, 11, 0.72);
    border-bottom: 1px solid var(--hair);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 62px;
  }
  .nav-brand {
    text-decoration: none;
  }
  .nav-links {
    display: none;
    gap: 26px;
    margin-inline: auto;
  }
  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.15s ease;
  }
  .nav-links a:hover {
    color: var(--ink);
  }
  .nav-cta {
    padding: 9px 16px;
    font-size: 14px;
  }
  @media (max-width: 640px) {
    .nav-cta {
      display: none;
    }
  }
  @media (min-width: 860px) {
    .nav-links {
      display: flex;
    }
  }
</style>
