---
import Wordmark from "./Wordmark.astro";
const dash = "https://app.intendr.app";
---

<footer class="footer">
  <div class="wrap">
    <div class="cta-band card">
      <div>
        <h2 class="cta-title">Give your agent a wallet, not your card.</h2>
        <p class="cta-sub">Per-user spend-capped wallets, over MCP.</p>
      </div>
      <a class="btn btn-primary" href={dash}>Open the dashboard</a>
    </div>

    <div class="foot-inner">
      <a href="#main" class="foot-brand" aria-label="intendr home">
        <Wordmark size={17} />
      </a>
      <p class="foot-tag">Per-user spend-capped wallets, over MCP.</p>
      <nav class="foot-links" aria-label="Footer">
        <a href={dash}>Dashboard</a>
        <a href="#connect">Connect</a>
        <a href="#tools">Tools</a>
      </nav>
    </div>

    <p class="foot-built mono">Built for the Ramp hackathon.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--hair);
    padding-block: clamp(48px, 7vw, 80px);
  }
  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    padding: 32px;
    background:
      radial-gradient(600px 300px at 100% 0%, rgba(198, 242, 78, 0.1), transparent 60%),
      linear-gradient(180deg, var(--panel), var(--elev));
  }
  .cta-title {
    font-size: clamp(22px, 3.4vw, 30px);
    max-width: 18ch;
  }
  .cta-sub {
    margin-top: 8px;
    color: var(--muted);
    font-size: 15px;
  }
  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--hair);
  }
  .foot-brand {
    text-decoration: none;
  }
  .foot-tag {
    color: var(--faint);
    font-size: 13.5px;
    margin-right: auto;
  }
  .foot-links {
    display: flex;
    gap: 22px;
  }
  .foot-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.15s ease;
  }
  .foot-links a:hover {
    color: var(--ink);
  }
  .foot-built {
    margin-top: 22px;
    color: var(--faint);
    font-size: 12px;
  }
</style>
